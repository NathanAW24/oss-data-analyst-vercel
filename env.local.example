# oss-data-analyst Web App Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Development
NODE_ENV=development

# Security - Allowed schemas for queries (comma-separated)
ALLOWED_SCHEMAS=analytics,crm

# Postgres (for local dev / docker)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=secret
PGDATABASE=oss_data_analyst
PGSSLMODE=disable

# AI Provider (OpenAI)
OPENAI_API_KEY=lol-u-think
# Optional: override the OpenAI-compatible base URL
OPENAI_BASE_URL=gatewayurl.com